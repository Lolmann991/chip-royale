<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Starter, damit im Hauptordner ein einfaches `dotnet run` das Spiel startet.
    Er baut nur ein winziges Programm und ruft dann `dotnet run` für src/ChipRoyale.Web auf.
    `dotnet build` und `dotnet test` im Hauptordner nehmen weiterhin ChipRoyale.slnx
    (MSBuild bevorzugt die Solution, wenn Projekt und Solution gleich heißen).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <RunCommand>dotnet</RunCommand>
    <RunArguments>run --project "$(MSBuildThisFileDirectory)src/ChipRoyale.Web/ChipRoyale.Web.csproj"</RunArguments>
    <RunWorkingDirectory>$(MSBuildThisFileDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="tools/launcher/Launcher.cs" />
  </ItemGroup>

</Project>
