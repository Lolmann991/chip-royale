<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The game itself: runs completely in the browser (WebAssembly). Can be hosted as static
       files (GitHub Pages) or by ChipRoyale.Server, which also stores accounts in the database. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChipRoyale.Client</RootNamespace>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Offline version: service worker caches the app for play without internet. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChipRoyale.Engine\ChipRoyale.Engine.csproj" />
    <ProjectReference Include="..\ChipRoyale.Shared\ChipRoyale.Shared.csproj" />
  </ItemGroup>

</Project>
