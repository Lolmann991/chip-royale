@* A small top-down table for the lessons: seats, dealer button, blinds, positions, acting order.
   Seats go clockwise from the bottom (= to the left of each player), like at the real table. *@

<div class="mini-table @(OnSeat.HasDelegate ? "clickable" : "")">
    <div class="mini-felt"></div>
    @for (var i = 0; i < Spec.Seats; i++)
    {
        var seat = i;
        var (x, y) = Pos(seat);
        var state = Marked.TryGetValue(seat, out var m) ? m : "";
        var position = Spec.ShowPositions ? Spec.PositionOf(seat) : (Position?)null;
        <button type="button" class="mini-seat @state @(seat == 0 ? "you" : "") @(position is { } p ? $"pos-{p}" : "")"
                style="left:@F(x)%; top:@F(y)%" disabled="@(!OnSeat.HasDelegate)"
                aria-label="@(seat == 0 ? L("Mini.You") : L("Mini.Seat", seat + 1))"
                @onclick="() => OnSeat.InvokeAsync(seat)">
            <span class="mini-avatar">@(seat == 0 ? "😎" : Avatars[seat % Avatars.Length])</span>
            <span class="mini-name">@(seat == 0 ? L("Mini.You") : L("Mini.Seat", seat + 1))</span>
            @if (Spec.OrderOf(seat) is { } order)
            {
                <span class="mini-order">@order</span>
            }
            @if (position is { } pos)
            {
                <span class="mini-pos">@L($"Mini.{pos}")</span>
            }
        </button>

        var (cx, cy) = Toward(seat, 0.42);
        @if (seat == Spec.Dealer)
        {
            <span class="mini-chip dealer" style="left:@F(cx)%; top:@F(cy)%">D</span>
        }
        @if (Spec.ShowBlinds && seat == Spec.SeatOf(SeatRole.SmallBlind))
        {
            var (bx, by) = Toward(seat, seat == Spec.Dealer ? 0.62 : 0.42);
            <span class="mini-chip sb" style="left:@F(bx)%; top:@F(by)%">SB</span>
        }
        @if (Spec.ShowBlinds && seat == Spec.SeatOf(SeatRole.BigBlind))
        {
            <span class="mini-chip bb" style="left:@F(cx)%; top:@F(cy)%">BB</span>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public MiniTableSpec Spec { get; set; } = default!;

    /// <summary>Set to make seats clickable.</summary>
    [Parameter] public EventCallback<int> OnSeat { get; set; }

    /// <summary>Seat → CSS state ("right" / "wrong") after answering.</summary>
    [Parameter] public IReadOnlyDictionary<int, string> Marked { get; set; } = new Dictionary<int, string>();

    private static readonly string[] Avatars = ["😎", "🦊", "🐻", "🐯", "🦉", "🐼"];

    private (double X, double Y) Pos(int seat)
    {
        // Seat 0 at the bottom, then clockwise on screen (bottom → left → top → right).
        var angle = Math.PI / 2 + seat * 2 * Math.PI / Spec.Seats;
        return (50 + 44 * Math.Cos(angle), 50 + 40 * Math.Sin(angle));
    }

    private (double X, double Y) Toward(int seat, double t)
    {
        var (x, y) = Pos(seat);
        return (x + (50 - x) * t, y + (50 - y) * t);
    }

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
