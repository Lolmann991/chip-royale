@using System.Globalization
@using ChipRoyale.Shared
@implements IAsyncDisposable
@inject PlayerService Player
@inject IJSRuntime JS

@* Developer console (^ or F2): commands to unlock items, set chips and crowns, … for testing.
   Profile commands run on the server when online (if it allows them), otherwise on the browser profile. *@

@if (open)
{
    <div class="devcon" role="dialog" aria-label="@L("Dev.Title")">
        <div class="devcon-head">
            <b>🛠 @L("Dev.Title")</b>
            <span class="devcon-target">@(Player.Mode == PlayerMode.Online ? L("Dev.Target.Server") : L("Dev.Target.Local"))</span>
            <button type="button" class="icon-btn" title="@L("Dev.Close")" @onclick="CloseAsync">✕</button>
        </div>
        <div class="devcon-out" id="devcon-out">
            @foreach (var line in lines)
            {
                <div class="devcon-line @line.Kind">@line.Text</div>
            }
        </div>
        <form class="devcon-in" @onsubmit="RunAsync" @onsubmit:preventDefault="true">
            <span class="devcon-prompt">›</span>
            <input id="devcon-input" @bind="input" @bind:event="oninput" @onkeydown="OnKeyAsync" disabled="@busy"
                   spellcheck="false" autocomplete="off" placeholder="help" aria-label="@L("Dev.Title")" />
        </form>
    </div>
}

@code {
    private sealed record Line(string Text, string Kind);

    private readonly List<Line> lines = [];
    private readonly List<string> history = [];
    private DotNetObjectReference<DevConsole>? self;
    private bool open;
    private bool busy;
    private bool focus;
    private string input = "";
    private int historyIndex;

    private static bool German => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de";

    private static readonly string[] ConsoleCommands = ["help", "clear", "status", "server", "close"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chipRoyale.devConsole.init", self);
        }
        if (open)
        {
            await JS.InvokeVoidAsync("chipRoyale.devConsole.scroll");
            if (focus)
            {
                focus = false;
                await JS.InvokeVoidAsync("chipRoyale.devConsole.focus");
            }
        }
    }

    [JSInvokable]
    public async Task Toggle()
    {
        if (open)
        {
            await CloseAsync();
            return;
        }
        await Player.LoadAsync();
        open = true;
        focus = true;
        if (lines.Count == 0)
        {
            Print(L("Dev.Welcome"), "info");
            Print(L("Dev.Marked"), "info");
        }
        StateHasChanged();
    }

    private Task CloseAsync()
    {
        open = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Print(string text, string kind = "") => lines.Add(new Line(text, kind));

    private async Task RunAsync()
    {
        var line = input.Trim();
        input = "";
        if (line.Length == 0) return;
        if (history.Count == 0 || history[^1] != line) history.Add(line);
        historyIndex = history.Count;
        Print("› " + line, "cmd");

        var parts = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        switch (parts[0].ToLowerInvariant())
        {
            case "help" or "?":
                PrintHelp();
                break;
            case "clear" or "cls":
                lines.Clear();
                break;
            case "close" or "exit":
                await CloseAsync();
                return;
            case "status":
                Print(L("Dev.Status", L($"Conn.{Player.Mode}"), Player.HasServer ? Player.ServerUrl : "–",
                    Player.IsLoggedIn ? Player.Email ?? "" : L("Dev.NoAccount")), "ok");
                break;
            case "server":
                if (parts.Length != 2)
                {
                    Print("server <http://… | none>", "err");
                    break;
                }
                busy = true;
                await Player.SetServerAsync(parts[1]);
                busy = false;
                Print(L("Dev.ServerSet", Player.HasServer ? Player.ServerUrl : "–", L($"Conn.{Player.Mode}")), "ok");
                break;
            default:
                if (Player.InGame && parts[0].Equals("reset", StringComparison.OrdinalIgnoreCase))
                {
                    Print(L("Dev.NotInGame"), "err");
                    break;
                }
                busy = true;
                StateHasChanged();
                var result = await Player.DevAsync(line);
                busy = false;
                foreach (var text in result.Output) Print(text, result.Ok ? "ok" : "err");
                break;
        }
        focus = true;
    }

    private void PrintHelp()
    {
        Print(L("Dev.Help.Console"), "head");
        Print($"  {"help",-14} {L("Dev.Cmd.Help")}");
        Print($"  {"clear",-14} {L("Dev.Cmd.Clear")}");
        Print($"  {"status",-14} {L("Dev.Cmd.Status")}");
        Print($"  {"server <url>",-14} {L("Dev.Cmd.Server")}");
        Print($"  {"close",-14} {L("Dev.Cmd.Close")}");
        Print(L("Dev.Help.Profile"), "head");
        foreach (var (name, args, de, en) in DevCommands.Help)
            Print($"  {name} {args}".PadRight(34) + " " + (German ? de : en));
        Print(L("Dev.Help.Categories", string.Join(", ", Enum.GetNames<Engine.Economy.ItemCategory>().Select(n => n.ToLowerInvariant()))), "info");
    }

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowUp" when history.Count > 0:
                historyIndex = Math.Max(0, historyIndex - 1);
                input = history[historyIndex];
                break;
            case "ArrowDown" when history.Count > 0:
                historyIndex = Math.Min(history.Count, historyIndex + 1);
                input = historyIndex < history.Count ? history[historyIndex] : "";
                break;
            case "Tab":
                Complete();
                break;
            case "Escape":
                await CloseAsync();
                break;
        }
    }

    /// <summary>Completes the command or its last argument (shows the choices when several fit).</summary>
    private void Complete()
    {
        var endsWithSpace = input.EndsWith(' ');
        var parts = input.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (parts.Count == 0) return;
        var completingCommand = parts.Count == 1 && !endsWithSpace;
        var prefix = endsWithSpace ? "" : parts[^1];
        var options = (completingCommand ? ConsoleCommands.Concat(DevCommands.Names) : DevCommands.Completions(parts[0]))
            .Where(o => o.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)).Distinct().ToList();
        if (options.Count == 0) return;

        var common = options.Aggregate((a, b) => new string(a.Zip(b).TakeWhile(p => char.ToLowerInvariant(p.First) == char.ToLowerInvariant(p.Second)).Select(p => p.First).ToArray()));
        if (options.Count > 1 && common.Length <= prefix.Length)
        {
            Print(string.Join("  ", options.Take(40)) + (options.Count > 40 ? " …" : ""), "info");
            return;
        }
        var word = options.Count == 1 ? options[0] + " " : common;
        if (!endsWithSpace) parts[^1] = word.TrimEnd(); else parts.Add(word.TrimEnd());
        input = string.Join(' ', parts) + (word.EndsWith(' ') ? " " : "");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("chipRoyale.devConsole.dispose");
        }
        catch (JSDisconnectedException) { }
        self?.Dispose();
    }
}
