@using ChipRoyale.Engine.Cards
@using ChipRoyale.Engine.Evaluation
@using ChipRoyale.Engine.Holdem

@* One player's name plate with chips and speech bubble. Stands upright on the rail (billboard); the cards lie on the felt (PokerTable). *@

<div class="seat-anchor" style="left:@X; top:@Y">
    <div class="seat @(Badge is null ? "" : "badged") @(Player.IsHuman ? "hero" : "") @(Acting ? "acting" : "") @(Player.HasFolded ? "folded" : "") @(WonAmount > 0 ? "winner" : "") @(Player.IsEliminated && !Player.InHand ? "eliminated" : "")"
         id="seat-@Index">
        <div class="plate">
            <div class="avatar @Look.AvatarClass" style="--hue:@Look.Hue">@Look.Avatar</div>
            <div class="who">
                <span class="name">@Look.Name</span>
                <span class="stack">@Player.Chips.ToString("N0")</span>
            </div>
            @if (Thinking)
            {
                <div class="bubble"><span class="thinking-dots"><i></i><i></i><i></i></span></div>
            }
            else if (WonAmount > 0)
            {
                <div class="bubble won">+@WonAmount.ToString("N0")</div>
            }
            else if (Player.LastAction is { } la && ShowAction)
            {
                <div class="bubble @la.Type" @key="(HandNumber, Street, la)">@HandText.Action(la)</div>
            }
            @if (Badge is not null)
            {
                <span class="seat-badge">@Badge</span>
            }
        </div>
        @if (ShowdownHand is not null)
        {
            <div class="hand-tag">@HandText.Describe(ShowdownHand)</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = default!;
    [Parameter, EditorRequired] public SeatLook Look { get; set; } = default!;
    [Parameter] public int Index { get; set; }

    /// <summary>Position on the table in CSS units (e.g. "50%").</summary>
    [Parameter] public string X { get; set; } = "50%";
    [Parameter] public string Y { get; set; } = "50%";

    [Parameter] public int HandNumber { get; set; }
    [Parameter] public Street Street { get; set; }
    [Parameter] public bool Acting { get; set; }
    [Parameter] public bool Thinking { get; set; }
    [Parameter] public bool ShowAction { get; set; } = true;
    [Parameter] public int WonAmount { get; set; }
    [Parameter] public HandValue? ShowdownHand { get; set; }


    /// <summary>Small extra label on the plate, e.g. a tournament place.</summary>
    [Parameter] public string? Badge { get; set; }
}
