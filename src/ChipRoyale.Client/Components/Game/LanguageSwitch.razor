@inject IJSRuntime JS
@inject NavigationManager Nav

@* Language toggle. Saves the choice and reloads, so the new language applies everywhere. *@
<span class="lang-switch" role="group" aria-label="@L("Common.Language")">
    @foreach (var culture in ChipRoyale.Client.Localization.Loc.SupportedCultures)
    {
        var c = culture;
        var active = Language == c;
        <button type="button" class="lang @(active ? "on" : "")" aria-pressed="@active" @onclick="() => SwitchAsync(c)">@c.ToUpperInvariant()</button>
    }
</span>

@code {
    private async Task SwitchAsync(string culture)
    {
        if (culture == Language) return;
        await JS.InvokeVoidAsync("chipRoyale.setCulture", culture);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
