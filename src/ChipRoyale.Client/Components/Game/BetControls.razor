@using ChipRoyale.Engine.Holdem

@* Fold / check-call / bet-raise buttons with the bet slider and pot presets. *@

@if (Legal.CanRaise)
{
    <div class="raise-panel">
        <button type="button" class="preset" @onclick="() => Change(Legal.MinRaiseTo)">Min</button>
        <button type="button" class="preset" @onclick="() => Change(PotRaise(0.5))">½ Pot</button>
        <button type="button" class="preset" @onclick="() => Change(PotRaise(0.75))">¾ Pot</button>
        <button type="button" class="preset" @onclick="() => Change(PotRaise(1))">Pot</button>
        <button type="button" class="preset" @onclick="() => Change(Legal.MaxRaiseTo)">All-in</button>
        <button type="button" class="step" @onclick="() => Change(RaiseTo - Step)">−</button>
        <input type="range" class="raise-slider" min="@Legal.MinRaiseTo" max="@Legal.MaxRaiseTo" step="@Unit"
               value="@RaiseTo" @oninput="OnSlider" style="--p:@Percent%" aria-label="@L("Table.Bet.Aria")" />
        <button type="button" class="step" @onclick="() => Change(RaiseTo + Step)">+</button>
    </div>
}
<div class="buttons">
    <button type="button" class="act fold" @onclick="() => OnAct.InvokeAsync(PlayerAction.Fold())">@L("Table.Fold") <kbd>F</kbd></button>
    <button type="button" class="act call" @onclick="() => OnAct.InvokeAsync(PlayerAction.Call())">
        @(Legal.CanCheck ? L("Table.Check") : Legal.ToCall >= HeroChips ? L("Table.CallAllIn", Legal.ToCall) : L("Table.Call", Legal.ToCall)) <kbd>C</kbd>
    </button>
    @if (Legal.CanRaise)
    {
        <button type="button" class="act raise" @onclick="() => OnAct.InvokeAsync(RaiseAction)">
            @(RaiseTo >= Legal.MaxRaiseTo ? L("Table.CallAllIn", RaiseTo) : Legal.CurrentBet == 0 ? L("Table.Bet", RaiseTo) : L("Table.RaiseTo", RaiseTo)) <kbd>R</kbd>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public LegalActions Legal { get; set; } = default!;
    [Parameter] public int RaiseTo { get; set; }
    [Parameter] public int HeroChips { get; set; }

    /// <summary>Slider step (small blind).</summary>
    [Parameter] public int Unit { get; set; } = 1;

    /// <summary>Step of the − / + buttons (big blind).</summary>
    [Parameter] public int Step { get; set; } = 1;

    [Parameter] public EventCallback<PlayerAction> OnAct { get; set; }

    /// <summary>The player moved the slider or used a preset (value not clamped yet).</summary>
    [Parameter] public EventCallback<int> OnRaiseChange { get; set; }

    /// <summary>The bet/raise action for a raise-to amount (all-in when it uses the whole stack).</summary>
    public static PlayerAction RaiseFor(LegalActions legal, int raiseTo) =>
        raiseTo >= legal.MaxRaiseTo ? PlayerAction.AllIn() : PlayerAction.RaiseTo(raiseTo);

    /// <summary>Raise-to amount for a fraction of the pot after calling.</summary>
    public static int PotRaise(LegalActions legal, double fraction) =>
        legal.CurrentBet + (int)((legal.Pot + legal.ToCall) * fraction);

    private PlayerAction RaiseAction => RaiseFor(Legal, RaiseTo);

    private int PotRaise(double fraction) => PotRaise(Legal, fraction);

    private string Percent => (Legal.MaxRaiseTo <= Legal.MinRaiseTo ? 100
        : (RaiseTo - Legal.MinRaiseTo) * 100.0 / (Legal.MaxRaiseTo - Legal.MinRaiseTo))
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private Task Change(int value) => OnRaiseChange.InvokeAsync(value);

    private Task OnSlider(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var v) ? Change(v) : Task.CompletedTask;
}
