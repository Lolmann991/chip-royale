@using ChipRoyale.Engine.Cards

<div class="card3d @Size @(FaceUp && Card is not null ? "up" : "down") @(Highlight ? "win" : "") @(Dim ? "dim" : "") @(Deal ? "deal" : "") @Class"
     style="--d:@(DelayMs)ms; @Style">
    <div class="card-inner">
        @if (Card is { } c)
        {
            var red = HandText.IsRed(c.Suit);
            var face = c.Rank >= Rank.Jack && c.Rank != Rank.Ace;
            <div class="card-face front @(red ? "red" : "black") suit-@c.Suit">
                <div class="corner tl"><b>@HandText.RankSymbol(c.Rank)</b><i>@HandText.SuitSymbol(c.Suit)</i></div>
                @if (face)
                {
                    <div class="court"><span class="court-rank">@HandText.RankSymbol(c.Rank)</span><span class="court-suit">@HandText.SuitSymbol(c.Suit)</span></div>
                }
                else
                {
                    <div class="pip">@HandText.SuitSymbol(c.Suit)</div>
                }
                <div class="corner br"><b>@HandText.RankSymbol(c.Rank)</b><i>@HandText.SuitSymbol(c.Suit)</i></div>
            </div>
        }
        else
        {
            <div class="card-face front"></div>
        }
        <div class="card-face back"><div class="back-art"></div></div>
    </div>
</div>

@code {
    [Parameter] public Card? Card { get; set; }
    [Parameter] public bool FaceUp { get; set; } = true;
    /// <summary>sm, md or lg.</summary>
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public bool Highlight { get; set; }
    [Parameter] public bool Dim { get; set; }
    [Parameter] public bool Deal { get; set; } = true;
    [Parameter] public int DelayMs { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
}
