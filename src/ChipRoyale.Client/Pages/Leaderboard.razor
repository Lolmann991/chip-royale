@page "/rangliste"
@using ChipRoyale.Shared
@inject GameServer Server
@inject PlayerService Player

<PageTitle>@L("Board.PageTitle")</PageTitle>

<div class="game-root @Player.ThemeClasses">
    <div class="board-page">
        <header class="board-head">
            <a class="brand" href="">♠ Chip <span>Royale</span></a>
            <span class="head-tools">
                <LanguageSwitch />
                <a class="tool" href="">@L("Board.Back")</a>
            </span>
        </header>

        <h1 class="logo small">@L("Board.Title1")<span>@L("Board.Title2")</span></h1>

        <nav class="tabs">
            @foreach (var (key, label) in Tabs)
            {
                <a class="tab @(Mode == key ? "on" : "")" href="rangliste?sort=@key">@L(label)</a>
            }
        </nav>

        @if (!loaded)
        {
            <p class="note center">…</p>
        }
        else if (offline)
        {
            <p class="note highlight center">@L("Board.Offline")</p>
        }
        else if (rows.Count == 0)
        {
            <p class="note center">@L("Board.Empty")</p>
        }
        else
        {
            <ol class="leaderboard">
                @foreach (var row in rows)
                {
                    <li class="lb-row @(row.IsMe ? "me" : "") @(row.Rank <= 3 ? $"top{row.Rank}" : "")">
                        <span class="lb-rank">@(row.Rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => row.Rank.ToString() })</span>
                        <span class="lb-name">@row.Name@(row.IsMe ? L("Board.You") : "")</span>
                        <span class="lb-main">@(Mode is "tische" or "turniere" ? "🏆 " : "● ")@Main(row).ToString("N0")</span>
                        <span class="lb-sub">@Describe(row)</span>
                    </li>
                }
            </ol>
        }

        @if (me is { } m && !rows.Any(r => r.IsMe))
        {
            <p class="note center">@L("Board.YourRank", m.Rank, Main(m))</p>
        }
        @if (loaded && !offline && !Player.IsLoggedIn)
        {
            <p class="note center"><a href="login">@L("Board.LoginLink")</a>@L("Board.LoginText")</p>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }

    private static readonly (string Key, string Label)[] Tabs =
    [
        ("rekord", "Board.Tab.Record"),
        ("aktuell", "Board.Tab.Current"),
        ("tische", "Board.Tab.Tables"),
        ("turniere", "Board.Tab.Tournaments"),
    ];

    private string Mode => Tabs.Any(t => t.Key == Sort) ? Sort! : "rekord";
    private bool loaded;
    private bool offline;
    private IReadOnlyList<LeaderboardEntry> rows = [];
    private LeaderboardEntry? me;

    protected override async Task OnParametersSetAsync()
    {
        await Player.LoadAsync();
        loaded = false;
        try
        {
            var response = await Server.GetAsync<LeaderboardResponse>($"{ApiRoutes.Leaderboard}?sort={Mode}");
            rows = response?.Top ?? [];
            me = response?.Me;
            offline = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or UnauthorizedAccessException)
        {
            offline = true;
        }
        loaded = true;
    }

    private int Main(LeaderboardEntry e) => Mode switch
    {
        "aktuell" => e.Total,
        "tische" => e.TablesCleared,
        "turniere" => e.TournamentsWon,
        _ => e.BestPeak,
    };

    private static string Hands(int n) => n == 1 ? L("Board.Hand") : L("Board.Hands", n);

    private string Describe(LeaderboardEntry e) => Mode switch
    {
        "aktuell" => L("Board.Sub.Current", e.Run, e.BestPeak),
        "tische" => L("Board.Sub.Tables", e.HandsWon, Hands(e.HandsPlayed)),
        "turniere" => L("Board.Sub.Tournaments", e.TournamentsPlayed),
        _ => L("Board.Sub.Record", e.Total, Hands(e.HandsPlayed)),
    };
}
