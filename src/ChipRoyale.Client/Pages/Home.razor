@page "/"
@layout GameLayout
@using ChipRoyale.Client.Components.Game
@using ChipRoyale.Client.Services
@implements IDisposable
@inject PlayerService Player

<PageTitle>Chip Royale</PageTitle>

<div class="game-root @(settings is null ? "" : $"diff-{settings.Difficulty}") @Player.ThemeClasses">
    <AchievementToasts />
    @if (!loaded)
    {
        <div class="loading">♠</div>
    }
    else if (settings is null)
    {
        <Lobby @key="lobbyKey" OnStart="StartAsync" Notice="@notice" Practice="@(Practice == "1")" />
    }
    else if (settings.IsBlackjack)
    {
        <BlackjackTable @key="tableKey" Settings="settings" OnExit="ExitAsync" OnStack="StackAsync" OnRound="BlackjackRoundAsync" />
    }
    else
    {
        <PokerTable @key="tableKey" Settings="settings" HeroLook="Player.HeroLook" Charm="@Player.Charm" OnExit="ExitAsync" OnReport="ReportAsync" OnTournamentFinished="TournamentFinishedAsync" />
    }
</div>

@code {
    /// <summary>?practice=1 preselects the practice table (link from the tutorial).</summary>
    [SupplyParameterFromQuery(Name = "practice")] public string? Practice { get; set; }

    private GameSettings? settings;
    private int tableKey;
    private int lobbyKey;
    private bool loaded;
    private string? notice;

    protected override async Task OnInitializedAsync()
    {
        await Player.LoadAsync();
        Player.Changed += OnPlayerChanged;
        loaded = true;
    }

    /// <summary>Server found or lost, login, logout: show the lobby with the new profile.</summary>
    private void OnPlayerChanged()
    {
        if (settings is null) lobbyKey++;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Player.Changed -= OnPlayerChanged;

    private async Task StartAsync(GameSettings s)
    {
        if (s.IsTournament)
            await Player.EnterTournamentAsync(s.Tournament!.Id);
        else if (!s.IsPractice)
            await Player.BuyInAsync(s.Stake, s.BuyIn);
        Player.DismissNotices();
        notice = null;
        tableKey++;
        settings = s;
        Player.InGame = true;
    }

    private async Task ExitAsync(int stack)
    {
        var s = settings!;
        if (!s.IsPractice && !s.IsTournament)
        {
            await Player.CashOutAsync(stack);
            var diff = stack - s.BuyIn;
            notice = diff switch
            {
                > 0 => L("Lobby.CashedOutProfit", stack, diff),
                < 0 when stack > 0 => L("Lobby.CashedOutLoss", stack, -diff),
                < 0 => null,
                _ => L("Lobby.CashedOutEven", stack),
            };
        }
        settings = null;
        Player.InGame = false;
        lobbyKey++;
    }

    private Task ReportAsync(TableReport report) => settings?.IsTournament == true
        ? report.Hand is { } hand ? Player.RecordHandAsync(hand) : Task.CompletedTask
        : Player.UpdateTableAsync(report.Stack, report.Hand);

    private Task StackAsync(int stack) => settings?.IsPractice == true ? Task.CompletedTask : Player.UpdateTableAsync(stack);

    private Task BlackjackRoundAsync(BlackjackReport report) => settings?.IsPractice == true
        ? Task.CompletedTask
        : Player.BlackjackRoundAsync(report.Stack, report.Round);

    private async Task TournamentFinishedAsync(TournamentResult result)
    {
        await Player.FinishTournamentAsync(settings!.Tournament!.Id, result.Place);
        notice = result.Prize > 0
            ? L("Sng.Notice.Prize", result.Place, result.Prize, result.Prize - settings!.BuyIn)
            : L("Sng.Notice.Out", result.Place);
    }
}
