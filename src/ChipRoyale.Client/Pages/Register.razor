@page "/register"
@using System.ComponentModel.DataAnnotations
@using ChipRoyale.Client.Localization
@inject PlayerService Player
@inject NavigationManager Nav

<PageTitle>@L("Account.Register")</PageTitle>

<div class="game-root account-root @Player.ThemeClasses">
    <div class="account-shell">
        <header class="board-head">
            <a class="brand" href="">♠ Chip <span>Royale</span></a>
            <span class="head-tools">
                <LanguageSwitch />
                <a class="tool" href="">@L("Board.Back")</a>
            </span>
        </header>
        <main class="account-main">
            <div class="auth-card">
                <div class="auth-cards" aria-hidden="true"><span>Q♦</span><span>J♣</span></div>
                <nav class="auth-tabs">
                    <a href="login">@L("Account.Login")</a>
                    <a class="on" href="register">@L("Account.Register")</a>
                </nav>
                <h1 class="auth-title">@L("Account.Register.Title")</h1>
                <p class="auth-sub">@L("Account.Register.Sub")</p>

                @if (errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        @foreach (var e in errors)
                        {
                            <div>@e</div>
                        }
                    </div>
                }
                <EditForm Model="input" OnValidSubmit="RegisterAsync" class="auth-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="auth-errors" role="alert" />
                    <label class="field">
                        <span>@L("Account.Email")</span>
                        <InputText @bind-Value="input.Email" autocomplete="username" placeholder="name@beispiel.de" />
                    </label>
                    <label class="field">
                        <span>@L("Account.Password")</span>
                        <InputText type="password" @bind-Value="input.Password" autocomplete="new-password" placeholder="••••••" />
                        <small>@L("Account.PasswordHint")</small>
                    </label>
                    <label class="field">
                        <span>@L("Account.ConfirmPassword")</span>
                        <InputText type="password" @bind-Value="input.ConfirmPassword" autocomplete="new-password" placeholder="••••••" />
                    </label>
                    <button type="submit" class="play-btn" disabled="@busy"><span>@(busy ? "…" : L("Account.Register.Button"))</span></button>
                </EditForm>
                <ul class="auth-perks">
                    <li>● @L("Account.Perk.Chips")</li>
                    <li>👑 @L("Account.Perk.Shop")</li>
                    <li>🏆 @L("Account.Perk.Board")</li>
                </ul>
                <p class="note">@(Player.HasServer ? L("Account.ServerNote", Player.ServerUrl) : L("Account.NoServer"))</p>
            </div>
        </main>
    </div>
</div>

@code {
    private readonly RegisterInput input = new();
    private IReadOnlyList<string> errors = [];
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Player.LoadAsync();
        // The offline version has no accounts.
        if (Player.OfflineEdition) Nav.NavigateTo("", replace: true);
    }

    private async Task RegisterAsync()
    {
        busy = true;
        errors = await Player.RegisterAsync(input.Email.Trim(), input.Password);
        busy = false;
        if (errors.Count == 0) Nav.NavigateTo("");
    }

    private sealed class RegisterInput
    {
        [Required(ErrorMessageResourceType = typeof(ValidationTexts), ErrorMessageResourceName = nameof(ValidationTexts.Required))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationTexts), ErrorMessageResourceName = nameof(ValidationTexts.EmailAddress))]
        [Display(ResourceType = typeof(ValidationTexts), Name = nameof(ValidationTexts.EmailName))]
        public string Email { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(ValidationTexts), ErrorMessageResourceName = nameof(ValidationTexts.Required))]
        [StringLength(100, MinimumLength = 6, ErrorMessageResourceType = typeof(ValidationTexts), ErrorMessageResourceName = nameof(ValidationTexts.PasswordLength))]
        [Display(ResourceType = typeof(ValidationTexts), Name = nameof(ValidationTexts.PasswordName))]
        public string Password { get; set; } = "";

        [Display(ResourceType = typeof(ValidationTexts), Name = nameof(ValidationTexts.ConfirmPasswordName))]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(ValidationTexts), ErrorMessageResourceName = nameof(ValidationTexts.PasswordCompare))]
        public string ConfirmPassword { get; set; } = "";
    }
}
