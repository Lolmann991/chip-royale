@using ChipRoyale.Engine.Ai
@using ChipRoyale.Engine.Cards
@using ChipRoyale.Engine.Evaluation
@using ChipRoyale.Engine.Holdem
@using ChipRoyale.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="game">
    <header class="topbar">
        <div class="brand">♠ Chip <span>Royale</span></div>
        <div class="meta">
            <span class="pill stake">@Roster.StakeName(Settings.Stake)@(Settings.IsPractice ? L("Table.PracticeSuffix") : "")</span>
            <span class="pill">Hand #@table.HandNumber</span>
            @if (sng is not null)
            {
                <span class="pill sng-level">@L("Sng.Level", sng.Level + 1, table.SmallBlind, table.BigBlind)</span>
                @if (sng.HandsLeftInLevel is { } left)
                {
                    <span class="pill">@(left == 1 ? L("Sng.RiseAfterThis") : L("Sng.RiseIn", left))</span>
                }
                <span class="pill">@L("Sng.PlayersLeft", sng.PlayersLeft, sng.Config.Players)</span>
            }
            else
            {
                <span class="pill">Blinds @table.SmallBlind.ToString("N0")/@table.BigBlind.ToString("N0")</span>
            }
            <span class="pill diff-@Settings.Difficulty">@Roster.DifficultyName(Settings.Difficulty)</span>
            @if (table.Phase is TablePhase.WaitingForAction or TablePhase.RoundComplete)
            {
                <span class="pill">@HandText.Street(table.Street)</span>
            }
        </div>
        <div class="tools">
            <button type="button" class="tool @(hints ? "on" : "")" title="@L("Table.Tips.Title")" @onclick="ToggleHints">@L("Table.Tips")</button>
            <button type="button" class="tool @(sound ? "on" : "")" title="@L("Table.Sound")" @onclick="ToggleSound">@(sound ? "🔊" : "🔇")</button>
            <button type="button" class="tool @(showRankings ? "on" : "")" title="@L("HandRankings.Title")" @onclick="() => showRankings = !showRankings">@L("Table.Hands")</button>
            <button type="button" class="tool @(showLog ? "on" : "")" title="@L("Table.Log")" @onclick="() => showLog = !showLog">📜</button>
            <button type="button" class="tool" @onclick="ExitAsync">@(Settings.IsPractice || Settings.IsTournament ? L("Table.Lobby") : L("Table.CashOut"))</button>
        </div>
    </header>

    <div class="scene" id="scene">
        <div class="table-3d @(sweeping ? "sweeping" : "")" id="table3d">
            <div class="table-shadow"></div>
            @for (var z = 1; z <= 6; z++)
            {
                <div class="table-edge" style="--z:-@(z * 5)px"></div>
            }
            <div class="rail"></div>
            <div class="felt">
                <div class="felt-line"></div>
            </div>

            <div class="deck">
                @for (var d = 0; d < 4; d++)
                {
                    <PlayingCard Card="null" FaceUp="false" Size="sm" Deal="false" Style="@($"transform: translateZ({d * 2}px)")" />
                }
            </div>

            <div class="pot" id="pot">
                <ChipStack Amount="PotAmount" MaxColumns="9" MaxPerColumn="10" />
            </div>
            @if (PotAmount > 0)
            {
                <div class="pot-label" id="pot-label">@L("Table.Pot", PotAmount)</div>
            }

            <div class="board">
                @for (var i = 0; i < 5; i++)
                {
                    var idx = i;
                    <div class="board-slot" style="--fx:@F((DeckX - 50) * 0.74 - (idx - 2) * 5.2)em; --fy:@F((DeckY - 52) * 0.74 / 2.1)em">
                        @if (idx < table.Board.Count)
                        {
                            var card = table.Board[idx];
                            var delay = idx < 3 ? idx * 160 : 0;
                            <div class="felt-card" @key="(table.HandNumber, card)" style="--d:@(delay)ms">
                                <PlayingCard Card="card" Deal="false"
                                             Highlight="winningCards.Contains(card)" Dim="winningCards.Count > 0 && !winningCards.Contains(card)" />
                            </div>
                        }
                    </div>
                }
            </div>

            @for (var i = 0; i < table.Players.Count; i++)
            {
                var p = table.Players[i];
                if (p.StreetBet <= 0) continue;
                var (bx, by) = BetPos(i);
                <div class="bet @(collecting ? "collect" : "") fresh" @key="(table.HandNumber, table.Street, i, p.StreetBet)"
                     style="left:@F(bx)%; top:@F(by)%; --dx:@F((50 - bx) * 0.74)em; --dy:@F((30 - by) * 0.74 / 2.1)em">
                    <ChipStack Amount="p.StreetBet" />
                    <span class="bet-label">@p.StreetBet.ToString("N0")</span>
                </div>
            }

            <div class="chip-tray" aria-hidden="true">
                @foreach (var color in TrayColors)
                {
                    <span class="tray-row c-@color"></span>
                }
            </div>

            @for (var i = 0; i < table.Players.Count; i++)
            {
                var p = table.Players[i];
                if (p.Chips <= 0) continue;
                var (px, py) = Layout[slots[i]].Stack;
                <div class="player-stack" style="left:@F(px)%; top:@F(py)%">
                    <ChipStack Amount="p.Chips" MaxColumns="4" MaxPerColumn="8" Class="small" />
                </div>
            }

            @for (var i = 0; i < table.Players.Count; i++)
            {
                var seat = i;
                var p = table.Players[seat];
                if (!p.InHand || p.HoleCards.Count == 0) continue;
                var (hx, hy) = Layout[slots[seat]].Cards;
                var hero = p.IsHuman;
                var faceUp = !p.HasFolded && ((hero && !peek) || (revealCards && p.IsActive && !hero));
                <div class="hole @(hero ? "hero-hole" : "") @(p.HasFolded ? "mucked" : "")" @key="(table.HandNumber, seat)"
                     style="left:@F(hx)%; top:@F(hy)%; --fx:@F((DeckX - hx) * 0.74)em; --fy:@F((DeckY - hy) * 0.74 / 2.1)em; --mx:@F((MuckX - hx) * 0.74)em; --my:@F((MuckY - hy) * 0.74 / 2.1)em"
                     @onclick="() => { if (hero) peek = !peek; }">
                    @for (var c = 0; c < p.HoleCards.Count; c++)
                    {
                        var card = p.HoleCards[c];
                        <div class="felt-card" style="--d:@(DealDelay(seat, c))ms; --c:@c; --spin:@((seat * 47 + c * 83) % 60 - 30)deg">
                            <PlayingCard Card="card" FaceUp="faceUp" Size="@(hero ? "md" : "sm")" Deal="false"
                                         Highlight="winningCards.Contains(card)" Dim="winningCards.Count > 0 && p.IsActive && !winningCards.Contains(card)" />
                        </div>
                    }
                </div>
            }

            @if (Charm is not null)
            {
                <div class="charm-anchor" style="left:36%; top:98%">
                    <div class="charm @(banner?.Win == true ? "cheer" : "")" title="@L("Shop.Tab.Charm")">@Charm</div>
                </div>
            }

            @if (table.Phase != TablePhase.Idle)
            {
                var (dx, dy) = DealerPos(table.DealerIndex);
                <div class="dealer-btn" style="left:@F(dx)%; top:@F(dy)%">D</div>
            }

            @for (var i = 0; i < table.Players.Count; i++)
            {
                var seat = i;
                var p = table.Players[seat];
                var (sx, sy) = SlotPos[slots[seat]];
                <SeatView Player="p" Look="looks[seat]" Index="seat" X="@($"{F(sx)}%")" Y="@($"{F(sy)}%")"
                          HandNumber="table.HandNumber" Street="table.Street"
                          Acting="table.ActingIndex == seat && table.Phase == TablePhase.WaitingForAction"
                          Thinking="thinkingSeat == seat"
                          ShowAction="table.Phase != TablePhase.HandComplete"
                          WonAmount="@(winners.Contains(seat) && lastResult is not null ? lastResult.Winnings[seat] : 0)"
                          ShowdownHand="@(lastResult is { WasShowdown: true } && lastResult.Hands.TryGetValue(seat, out var hv) ? hv : null)"
                          Badge="@SeatBadge(seat)" />
            }
        </div>

        @if (levelNotice is not null)
        {
            <div class="level-toast" @key="table.HandNumber">⏫ @levelNotice</div>
        }

        @if (banner is not null && gameOver is null)
        {
            <div class="banner @(banner.Win ? "win" : "") @(autoPaused ? "paused" : "")" @key="table.HandNumber" @onmouseenter="PauseAutoContinue">
                <h2 class="banner-title">@banner.Title</h2>
                <p class="banner-sub">@banner.Sub</p>
                <div class="banner-actions">
                    <button type="button" class="act next" @onclick="NextHandAsync">@L("Table.NextHand") <kbd>@L("Table.Key.Space")</kbd></button>
                </div>
                @if (autoPaused)
                {
                    <p class="banner-paused">@L("Table.AutoPaused")</p>
                }
                else if (autoContinueMs > 0)
                {
                    <div class="banner-progress" style="--t:@(autoContinueMs)ms"></div>
                }
            </div>
        }
    </div>

    <footer class="actionbar">
        <div class="hand-info">
            @if (Hero.InHand && Hero.HoleCards.Count == 2 && !Hero.HasFolded)
            {
                <div class="hand-name"><small>@L("Table.YourHand")</small>@HandText.DescribeCurrent(Hero.HoleCards, table.Board)</div>
                @if (hints && heroOdds is { } odds && table.Phase != TablePhase.HandComplete)
                {
                    <HeroStats Hole="Hero.HoleCards" Board="table.Board" Odds="odds" Opponents="Math.Max(1, table.ActivePlayerCount - 1)"
                               Legal="@(heroTurn ? legal : null)" StartingRank="startingRank" StartingTop="startingTop" />
                    @if (heroTurn)
                    {
                        var (tipText, tipKind) = Tip(odds.Equity);
                        <div class="tip @tipKind">@tipText</div>
                    }
                }
            }
            else if (Hero.HasFolded && table.Phase != TablePhase.HandComplete)
            {
                <div class="hand-name"><small>@L("Table.YourHand")</small>@L("Table.Folded")</div>
            }
        </div>

        <div class="controls">
            @if (heroTurn && legal is not null)
            {
                <BetControls Legal="legal" RaiseTo="raiseTo" HeroChips="Hero.Chips" Unit="RaiseUnit" Step="Math.Max(RaiseUnit, table.BigBlind)"
                             OnAct="HeroActAsync" OnRaiseChange="SetRaise" />
            }
            else if (table.Phase == TablePhase.HandComplete && gameOver is null && banner is null)
            {
                <button type="button" class="act next" @onclick="NextHandAsync">@L("Table.NextHand") <kbd>@L("Table.Key.Space")</kbd></button>
            }
            else if (thinkingSeat >= 0)
            {
                <div class="status">@looks[thinkingSeat].Avatar @L("Table.Thinking", looks[thinkingSeat].Name)</div>
            }
            else if (table.IsRunout)
            {
                <div class="status">@L("Table.Runout")</div>
            }
        </div>
    </footer>

    @if (showLog)
    {
        <aside class="log">
            <h3>@L("Table.Log")</h3>
            @foreach (var line in log.AsEnumerable().Reverse())
            {
                <div class="log-line @line.Kind">@line.Text</div>
            }
        </aside>
    }

    @if (showRankings)
    {
        <HandRankings Current="CurrentCategory" OnClose="() => showRankings = false" />
    }

    @if (tournamentResult is { } tr)
    {
        var paid = tr.Prize > 0;
        <div class="overlay">
            <div class="overlay-card @(paid ? "" : "lost")">
                <div class="trophy">@(tr.Place == 1 ? "🏆" : paid ? "🥈" : "🎗️")</div>
                <h2>@(tr.Place == 1 ? L("Sng.Won") : paid ? L("Sng.InTheMoney", tr.Place) : L("Sng.Out", tr.Place))</h2>
                <p>@(paid ? L("Sng.Prize", tr.Prize) : L("Sng.NoPrize", Settings.BuyIn))</p>
                <div class="stats">
                    <div><b>@(tr.Place).</b><span>@L("Sng.Place")</span></div>
                    <div><b>@handsPlayed</b><span>@L("Over.Hands")</span></div>
                    <div><b>@handsWon</b><span>@L("Over.Won")</span></div>
                    <div><b>@biggestPot.ToString("N0")</b><span>@L("Over.BiggestPot")</span></div>
                </div>
                <div class="banner-actions">
                    <button type="button" class="act next" @onclick="ExitAsync">@L("Table.Lobby")</button>
                </div>
            </div>
        </div>
    }
    else if (gameOver is { } go)
    {
        <div class="overlay">
            <div class="overlay-card @(go ? "" : "lost")">
                <div class="trophy">@(go ? "🏆" : "💸")</div>
                <h2>@(go ? L("Over.Cleared") : L("Over.Busted"))</h2>
                <p>
                    @if (go)
                    {
                        @L("Over.Cleared.Text", Hero.Chips)
                    }
                    else if (Settings.IsPractice)
                    {
                        @L("Over.Busted.Practice")
                    }
                    else
                    {
                        @L("Over.Busted.Text")
                    }
                </p>
                <div class="stats">
                    <div><b>@handsPlayed</b><span>@L("Over.Hands")</span></div>
                    <div><b>@handsWon</b><span>@L("Over.Won")</span></div>
                    <div><b>@biggestPot.ToString("N0")</b><span>@L("Over.BiggestPot")</span></div>
                    <div><b>@peakChips.ToString("N0")</b><span>@L("Over.Peak")</span></div>
                </div>
                <div class="banner-actions">
                    @if (go)
                    {
                        <button type="button" class="act next" @onclick="NewOpponentsAsync">@L("Over.NewOpponents")</button>
                        <button type="button" class="act call" @onclick="ExitAsync">@(Settings.IsPractice ? L("Table.Lobby") : L("Over.CashOutLobby"))</button>
                    }
                    else
                    {
                        @if (Settings.IsPractice)
                        {
                            <button type="button" class="act next" @onclick="RestartAsync">@L("Over.Again")</button>
                        }
                        <button type="button" class="act fold" @onclick="ExitAsync">@L("Table.Lobby")</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

