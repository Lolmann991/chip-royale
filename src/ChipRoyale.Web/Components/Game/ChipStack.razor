@* A small 3D pile of casino chips for an amount. Chips lie flat on the felt and are stacked along Z. *@

<div class="chip-pile @Class" title="@Amount.ToString("N0")">
    @foreach (var (color, count, col) in Columns())
    {
        <div class="chip-col" style="--col:@col">
            @for (var i = 0; i < count; i++)
            {
                <div class="chip3d c-@color" style="--i:@i"></div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Amount { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public int MaxColumns { get; set; } = 5;
    [Parameter] public int MaxPerColumn { get; set; } = 8;

    private static readonly (int Value, string Color)[] Denominations =
    [
        (5000, "orange"), (1000, "gold"), (500, "purple"), (100, "black"), (25, "green"), (5, "red"), (1, "white"),
    ];

    /// <summary>The top denomination is chosen so it shows at least this many chips (piles look fuller).</summary>
    [Parameter] public int MinTop { get; set; } = 6;

    private IEnumerable<(string Color, int Count, int Column)> Columns()
    {
        if (Amount <= 0) yield break;
        var start = Array.FindIndex(Denominations, d => Amount / d.Value >= MinTop);
        if (start < 0) start = Denominations.Length - 1;

        var rest = Amount;
        var col = 0;
        for (var i = start; i < Denominations.Length && rest > 0; i++)
        {
            var (value, color) = Denominations[i];
            var n = rest / value;
            rest -= n * value;
            while (n > 0)
            {
                if (col >= MaxColumns) yield break;
                var take = Math.Min(n, MaxPerColumn);
                yield return (color, take, col++);
                n -= take;
            }
        }
    }
}
