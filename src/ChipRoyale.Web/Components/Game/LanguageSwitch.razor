@inject NavigationManager Nav

@* Language toggle. Switching reloads the page so the new culture applies everywhere. *@
<span class="lang-switch" role="group" aria-label="@L("Common.Language")">
    @foreach (var culture in ChipRoyale.Web.Localization.Loc.SupportedCultures)
    {
        var c = culture;
        var active = Language == c;
        if (RendererInfo.IsInteractive)
        {
            <button type="button" class="lang @(active ? "on" : "")" aria-pressed="@active" @onclick="() => Switch(c)">@c.ToUpperInvariant()</button>
        }
        else
        {
            <a class="lang @(active ? "on" : "")" href="@Url(c)" data-enhance-nav="false">@c.ToUpperInvariant()</a>
        }
    }
</span>

@code {
    private string Url(string culture)
    {
        var current = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        return $"Culture/Set?culture={culture}&redirectUri={Uri.EscapeDataString(current)}";
    }

    private void Switch(string culture)
    {
        if (culture != Language) Nav.NavigateTo(Url(culture), forceLoad: true);
    }
}
