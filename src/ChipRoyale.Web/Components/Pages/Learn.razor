@page "/lernen"
@layout GameLayout
@rendermode InteractiveServer
@using ChipRoyale.Engine.Cards
@using ChipRoyale.Engine.Evaluation
@using ChipRoyale.Web.Components.Tutorial
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@L("Learn.PageTitle")</PageTitle>

<div class="game-root">
    <div class="board-page learn">
        <header class="board-head">
            <a class="brand" href="">♠ Chip <span>Royale</span></a>
            <span class="head-tools">
                <LanguageSwitch />
                <a class="tool" href="">@L("Board.Back")</a>
            </span>
        </header>

        @if (lesson is null)
        {
            <h1 class="logo small">@L("Learn.Title1")<span>@L("Learn.Title2")</span></h1>
            <p class="note center">@L("Learn.Intro")</p>

            <div class="lesson-grid">
                @for (var i = 0; i < Lessons.All.Count; i++)
                {
                    var l = Lessons.All[i];
                    var isDone = done.Contains(l.Id);
                    <button type="button" class="lesson-card @(isDone ? "done" : "")" @onclick="() => Open(l)">
                        <span class="lesson-icon">@l.Icon</span>
                        <span class="lesson-num">@(i + 1)</span>
                        <b>@L($"Learn.{l.Id}.Title")</b>
                        <span class="lesson-summary">@L($"Learn.{l.Id}.Summary")</span>
                        <span class="lesson-meta">
                            @L("Learn.Steps", l.Steps.Count)
                            @if (isDone)
                            {
                                <em>@L("Learn.Done")</em>
                            }
                        </span>
                        <span class="preset">@(isDone ? L("Learn.Repeat") : L("Learn.Start"))</span>
                    </button>
                }
                <a class="lesson-card practice" href="/?practice=1">
                    <span class="lesson-icon">🎓</span>
                    <b>@L("Learn.Practice.Title")</b>
                    <span class="lesson-summary">@L("Learn.Practice.Text")</span>
                    <span class="preset">@L("Learn.Practice.Go")</span>
                </a>
            </div>
        }
        else if (complete)
        {
            var next = NextLesson;
            <div class="overlay-card lesson-complete">
                <div class="trophy">🏅</div>
                <h2>@L("Learn.Complete.Title")</h2>
                <p>@(next is null ? L("Learn.Complete.All") : L("Learn.Complete.Text"))</p>
                <div class="banner-actions">
                    @if (next is not null)
                    {
                        <button type="button" class="act next" @onclick="() => Open(next)">@L("Learn.NextLesson", L($"Learn.{next.Id}.Title"))</button>
                    }
                    <a class="act call" href="/?practice=1">@L("Learn.Practice.Go")</a>
                    <button type="button" class="act fold" @onclick="Overview">@L("Learn.Overview")</button>
                </div>
            </div>
        }
        else
        {
            var s = Step;
            <div class="lesson-head">
                <button type="button" class="tool" @onclick="Overview">@L("Learn.Overview")</button>
                <h2>@lesson.Icon @L($"Learn.{lesson.Id}.Title")</h2>
                <span class="note">@L("Learn.StepOf", stepIndex + 1, lesson.Steps.Count)</span>
            </div>
            <div class="progress-dots">
                @for (var k = 0; k < lesson.Steps.Count; k++)
                {
                    <i class="@(k < stepIndex ? "done" : k == stepIndex ? "on" : "")"></i>
                }
            </div>

            <div class="step-card" @key="(lesson.Id, stepIndex)">
                <div class="step-text">
                    @foreach (var paragraph in Text(s.Key).Split('\n'))
                    {
                        <p>@paragraph</p>
                    }
                </div>

                @if (s.Kind == StepKind.Compare)
                {
                    var board = Cards(s.Board);
                    var a = Best(s.HandA, s.Board);
                    var b = Best(s.HandB, s.Board);
                    var winner = s.CompareWinner();
                    <div class="learn-felt">
                        <div class="learn-row">
                            <label>@L("Learn.Board")</label>
                            <div class="learn-cards">
                                @foreach (var c in board)
                                {
                                    <PlayingCard Card="c" Deal="true" Highlight="solved && WinCards(winner, a, b).Contains(c)" />
                                }
                            </div>
                        </div>
                        <div class="learn-hands">
                            @foreach (var (label, hand, value, idx) in new[] { ("Learn.HandA", s.HandA, a, 0), ("Learn.HandB", s.HandB, b, 1) })
                            {
                                <div class="learn-hand @(solved && (winner == idx || winner == 2) ? "winner" : "")">
                                    <label>@L(label)</label>
                                    <div class="learn-cards">
                                        @foreach (var c in Cards(hand))
                                        {
                                            <PlayingCard Card="c" Deal="true" Highlight="solved && (winner == idx || winner == 2) && value.Cards.Contains(c)" />
                                        }
                                    </div>
                                    @if (solved)
                                    {
                                        <span class="hand-tag">@HandText.Describe(value)</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="options">
                        @foreach (var (key, idx) in new[] { ("Learn.Compare.A", 0), ("Learn.Compare.B", 1), ("Learn.Compare.Split", 2) })
                        {
                            <button type="button" class="option @OptionState(idx, winner)" @onclick="() => Answer(idx, winner)">@L(key)</button>
                        }
                    </div>
                }
                else if (s.Hole is not null || s.Board is not null)
                {
                    var hole = Cards(s.Hole);
                    var board = Cards(s.Board);
                    var best = s.ShowBest && hole.Count + board.Count >= 5 ? HandEvaluator.EvaluateBest([.. hole, .. board]) : null;
                    <div class="learn-felt">
                        @if (s.Board is not null)
                        {
                            <div class="learn-row">
                                <label>@L("Learn.Board")</label>
                                <div class="learn-cards">
                                    @if (board.Count == 0)
                                    {
                                        <span class="note">@L("Learn.NoBoard")</span>
                                    }
                                    @foreach (var c in board)
                                    {
                                        <PlayingCard @key="c" Card="c" Highlight="best?.Cards.Contains(c) == true" />
                                    }
                                </div>
                            </div>
                        }
                        <div class="learn-row">
                            <label>@L("Learn.YourCards")</label>
                            <div class="learn-cards">
                                @foreach (var c in hole)
                                {
                                    <PlayingCard @key="c" Card="c" Size="lg" Highlight="best?.Cards.Contains(c) == true" />
                                }
                            </div>
                        </div>
                        @if (best is not null)
                        {
                            <div class="learn-best">@L("Learn.BestHand", HandText.Describe(best))</div>
                        }
                    </div>
                }

                @if (s.ShowRankings)
                {
                    <div class="rankings inline">
                        <HandRankings Inline="true" />
                    </div>
                }

                @if (s.Table is { } table)
                {
                    @if (s.Kind == StepKind.Seat)
                    {
                        <MiniTable Spec="table" OnSeat="seat => Answer(seat, table.SeatOf(s.Answer))" Marked="marks" />
                        @if (!solved)
                        {
                            <p class="note center">@L("Learn.ClickSeat")</p>
                        }
                    }
                    else
                    {
                        <MiniTable Spec="table" />
                    }
                }

                @if (s.Kind == StepKind.Quiz)
                {
                    <div class="options">
                        @for (var o = 0; o < s.Options; o++)
                        {
                            var idx = o;
                            <button type="button" class="option @OptionState(idx, s.Correct)" @onclick="() => Answer(idx, s.Correct)">@Text($"{s.Key}.{idx}")</button>
                        }
                    </div>
                }

                @if (s.Kind != StepKind.Info && (solved || wrong.Count > 0))
                {
                    <div class="feedback @(solved ? "right" : "wrong")" @key="(solved, wrong.Count)">
                        <b>@(solved ? L("Learn.Right") : L("Learn.Wrong"))</b>
                        @if (solved && s.Kind == StepKind.Compare)
                        {
                            <span>@L("Learn.Compare.Result", HandText.Describe(Best(s.HandA, s.Board)), HandText.Describe(Best(s.HandB, s.Board)))</span>
                        }
                        @if (solved && s.HasExplain)
                        {
                            <span>@Text($"{s.Key}.Explain")</span>
                        }
                    </div>
                }
            </div>

            <div class="lesson-nav">
                <button type="button" class="act fold" disabled="@(stepIndex == 0)" @onclick="Back">@L("Learn.Back")</button>
                <button type="button" class="act next" disabled="@(!CanAdvance)" @onclick="NextAsync">
                    @(stepIndex == lesson.Steps.Count - 1 ? L("Learn.Finish") : L("Learn.Next"))
                </button>
            </div>
        }
    </div>
</div>

@code {
    private Lesson? lesson;
    private int stepIndex;
    private bool solved;
    private bool complete;
    private readonly HashSet<int> wrong = [];
    private Dictionary<int, string> marks = [];
    private HashSet<string> done = [];
    private IJSObjectReference? js;

    private LessonStep Step => lesson!.Steps[stepIndex];
    private bool CanAdvance => Step.Kind == StepKind.Info || solved;

    private Lesson? NextLesson => lesson is null ? null
        : Lessons.All.SkipWhile(l => l != lesson).Skip(1).FirstOrDefault(l => !done.Contains(l.Id))
          ?? Lessons.All.FirstOrDefault(l => !done.Contains(l.Id));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/table.js");
            done = (await js.InvokeAsync<string[]>("loadLessons")).ToHashSet();
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or JSException) { }
    }

    private void Open(Lesson l)
    {
        lesson = l;
        stepIndex = 0;
        complete = false;
        ResetStep();
        _ = Js("unlockAudio");
    }

    private void Overview()
    {
        lesson = null;
        complete = false;
    }

    private void ResetStep()
    {
        solved = false;
        wrong.Clear();
        marks = [];
    }

    private void Back()
    {
        if (stepIndex == 0) return;
        stepIndex--;
        ResetStep();
    }

    private async Task NextAsync()
    {
        if (!CanAdvance) return;
        if (stepIndex < lesson!.Steps.Count - 1)
        {
            stepIndex++;
            ResetStep();
            _ = Js("sfx", "card");
            return;
        }

        done.Add(lesson.Id);
        complete = true;
        await Js("saveLessons", (object)done.ToArray()); // cast: pass the array as ONE argument
        _ = Js("sfx", "bigwin");
        _ = Js("celebrate", 2);
    }

    private void Answer(int choice, int correct)
    {
        if (solved) return;
        if (choice == correct)
        {
            solved = true;
            marks = new Dictionary<int, string>(marks) { [choice] = "right" };
            _ = Js("sfx", "win");
        }
        else
        {
            wrong.Add(choice);
            marks = new Dictionary<int, string>(marks) { [choice] = "wrong" };
            _ = Js("sfx", "fold");
        }
    }

    private string OptionState(int idx, int correct) =>
        solved && idx == correct ? "right" : wrong.Contains(idx) ? "wrong" : solved ? "muted" : "";

    private string Text(string stepKey) => L($"Learn.{lesson!.Id}.{stepKey}");

    private static IReadOnlyList<Card> Cards(string? text) =>
        string.IsNullOrWhiteSpace(text) ? [] : Card.ParseMany(text);

    private static HandValue Best(string? hand, string? board) =>
        HandEvaluator.EvaluateBest([.. Cards(hand), .. Cards(board)]);

    private static IReadOnlyList<Card> WinCards(int winner, HandValue a, HandValue b) => winner switch
    {
        0 => a.Cards,
        1 => b.Cards,
        _ => [.. a.Cards, .. b.Cards],
    };

    private async Task Js(string fn, params object?[] args)
    {
        if (js is null) return;
        try { await js.InvokeVoidAsync(fn, args); }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or JSException or ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (js is null) return;
        try { await js.DisposeAsync(); }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or JSException) { }
    }
}
