@page "/"
@layout GameLayout
@rendermode InteractiveServer
@using ChipRoyale.Web.Components.Game

<PageTitle>Chip Royale</PageTitle>

<div class="game-root @(settings is null ? "" : $"diff-{settings.Difficulty}")">
    @if (settings is null)
    {
        <Lobby OnStart="s => settings = s" />
    }
    else
    {
        <PokerTable @key="tableKey" Settings="settings" OnExit="() => { settings = null; tableKey++; }" />
    }
</div>

@code {
    private GameSettings? settings;
    private int tableKey;
}
